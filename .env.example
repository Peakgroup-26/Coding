# Copy to .env and fill in. Never commit .env.

# --- Required ---
# A long random string, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Database password (docker-compose uses it for the bundled PostgreSQL)
POSTGRES_PASSWORD=
# The first admin account, created when the database has no users
ADMIN_EMAIL=you@peakpcg.com.au
ADMIN_PASSWORD=

# --- File storage: local (default, the "files" volume) or s3 ---
STORAGE_BACKEND=local
# S3_BUCKET=peak-takeoff-files
# S3_PREFIX=takeoff
# AWS_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- AI reading (the autopilot). Sends each drawing page to Anthropic's API to be read. ---
# Without a key the app still runs, but plans are only sorted by keywords and nothing is taken off automatically.
TAKEOFF_AI=claude
ANTHROPIC_API_KEY=
# TAKEOFF_AI_MODEL=claude-opus-5-5
# How many jobs the autopilot reads at once
# AUTOPILOT_WORKERS=2

# --- Microsoft 365 sign-on (register an app in Entra ID) ---
# SSO_TENANT_ID=
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_REDIRECT_URI=https://takeoff.peakgroupdashboard.com.au/api/auth/sso/callback
# SSO_ALLOWED_DOMAINS=peakpcg.com.au
# SSO_AUTO_CREATE=false

# --- Other ---
# Port the app listens on, on the server only (Plesk forwards the website to it)
# APP_PORT=8000
# MAX_UPLOAD_MB=200
# TOKEN_TTL_HOURS=12
