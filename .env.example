# Copy to .env and fill in. Never commit .env.

# --- Required ---
# A long random string, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Database password (docker-compose uses it for the bundled PostgreSQL)
POSTGRES_PASSWORD=
# The first admin account, created when the database has no users
ADMIN_EMAIL=you@peakpcg.com.au
ADMIN_PASSWORD=

# --- File storage: local (default, the "files" volume) or s3 ---
STORAGE_BACKEND=local
# S3_BUCKET=peak-takeoff-files
# S3_PREFIX=takeoff
# AWS_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- AI reading (the autopilot). Sends each drawing page to Anthropic's API to be read. ---
# Without a key the app still runs, but plans are only sorted by keywords and nothing is taken off automatically.
TAKEOFF_AI=claude
ANTHROPIC_API_KEY=
# TAKEOFF_AI_MODEL=claude-opus-5-5
# How many jobs the autopilot reads at once
# AUTOPILOT_WORKERS=2

# --- Microsoft 365 sign-on (register an app in Entra ID) ---
# SSO_TENANT_ID=
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_REDIRECT_URI=https://takeoff.peakgroupdashboard.com.au/api/auth/sso/callback
# SSO_ALLOWED_DOMAINS=peakpcg.com.au
# SSO_AUTO_CREATE=false

# --- The web address people use (links in feedback emails, the Xero sign-in) ---
PUBLIC_URL=https://takeoff.peakgroupdashboard.com.au

# --- Email for customer follow-ups, feedback requests and POs (any SMTP: Microsoft 365, Google, SendGrid) ---
# Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, a mailbox and its password (or an app password)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=office@peakpcg.com.au

# --- Text messages (ClickSend, Australian SMS) ---
# CLICKSEND_USERNAME=
# CLICKSEND_API_KEY=
# SMS_FROM=Peak

# --- Xero (deploy/XERO.md) ---
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_SYNC_MINUTES=15
# Apps made after 2 March 2026 must use Xero's granular scopes; change this only if Xero's Scopes page says to
# XERO_SCOPES=openid profile email offline_access accounting.contacts accounting.invoices accounting.payments accounting.banktransactions.read accounting.settings.read accounting.reports.read

# --- Geotab (vehicle map; see deploy/GEOTAB.md) ---
# Use a read-only MyGeotab user made for Lorojo. Never paste these into chat; put them straight in this file on the server.
# GEOTAB_SERVER=my.geotab.com
# GEOTAB_DATABASE=
# GEOTAB_USERNAME=
# GEOTAB_PASSWORD=

# --- Other ---
# How long the team's phones stay signed in (days)
# FIELD_TOKEN_TTL_DAYS=60
# Port the app listens on, on the server only (Plesk forwards the website to it)
# APP_PORT=8000
# MAX_UPLOAD_MB=200
# TOKEN_TTL_HOURS=12
